# Track only the website, its public source inventory and project tooling.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/scripts/
!/.github/
!/design-proposals/
!/output/
/output/*
!/output/source/
/output/source/*
!/output/source/pages.json
!/output/source/assets-validated.json
!/output/source/extra-assets.json
!/output/source/recovered-assets.json
!/output/source/attachments-validated.json
!/output/source/assets/
!/output/source/attachments/
!/output/source/english/
/output/source/english/*
!/output/source/english/pages-clean.json
**/node_modules/
**/.env
**/.env.*
**/*.log
**/.DS_Store
**/Thumbs.db
